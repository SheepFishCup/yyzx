# ============================================================
# SkyWalking Agent 配置文件（放在 skywalking-agent.jar 同级目录）
# ============================================================
# 使用方法：
#   1. 下载 SkyWalking Java Agent: https://skywalking.apache.org/downloads/
#   2. 解压后找到 skywalking-agent.jar
#   3. 将此文件复制到 agent 目录下的 config/agent.config
#      或通过 JVM 参数指定: -Dskywalking_config=/path/to/agent.config
#
# 各服务的 service_name 通过 JVM 参数动态指定，不在此文件中配置
# ============================================================

# 收集器后端地址（SkyWalking OAP Server 的 gRPC 端口）
collector.backend_service=${SW_AGENT_COLLECTOR_BACKEND_SERVICES:localhost:11800}

# 日志级别
logging.level=${SW_LOGGING_LEVEL:INFO}

# 采样率（-1=全部, 0-10000 如 10000=100%）
agent.sample_n_per_3_secs=${SW_AGENT_SAMPLE_N_PER_3_SECS:-1}

# 忽略特定 URL 的追踪（健康检查、静态资源等）
trace.ignore_path=${SW_TRACE_IGNORE_PATH:/doc.html,/webjars/**,/v3/api-docs/**,/swagger-resources/**,/images/**,/druid/**,/internal/**}

# 最大 Span 数量（每个 Segment）
agent.span_limit_per_segment=${SW_SPAN_LIMIT:300}

# 将 TraceId 注入日志 MDC（配合 %X{traceId} 使用）
plugin.toolkit.log.transmit_formatted=false
