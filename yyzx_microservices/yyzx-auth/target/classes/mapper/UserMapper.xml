<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cqupt.auth.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="com.cqupt.pojo.User">
        <id column="id" property="id" />
        <id column="create_time" property="createTime" />
        <id column="create_by" property="createBy"/>
        <id column="update_time" property="updateTime" />
        <id column="update_by" property="updateBy"/>
        <id column="is_deleted" property="isDeleted" />
        <id column="nickname" property="nickname" />
        <id column="username" property="username" />
        <id column="password" property="password" />
        <id column="sex" property="sex" />
        <id column="email" property="email"/>
        <id column="role_id" property="roleId"/>
        <id column="phone_number" property="phoneNumber"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, create_time, create_by, update_time, update_by, is_deleted, nickname, username, password, sex, email, role_id, phone_number
    </sql>
    <!-- 分页查询用户（使用 XML 配置） -->
    <select id="selectUserPage" resultType="com.cqupt.pojo.User">
        SELECT
        id,
        create_time,
        create_by,
        update_time,
        update_by,
        is_deleted,
        nickname,
        username,
        password,
        sex,
        email,
        role_id,
        phone_number,
        status
        FROM user
        <where>
            is_deleted = 0
            <if test="nickName != null and nickName != ''">
                AND nickname LIKE CONCAT('%', #{nickName}, '%')
            </if>
            <if test="roleId != null">
                AND role_id = #{roleId}
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>